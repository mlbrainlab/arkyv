// Preferences (design/canvas/Settings.dc.html). One scrolling page of the
// mockup's groups. Only settings Crate already acts on are shown: Language,
// CPU threads, file manager entries and the keyring arrive with their own
// M5 tasks.
import { ScrollView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { CaptionBar, Frame, WindowFrame } from "frame.slint";
import { Locale } from "locale.slint";
import { Icon } from "icon.slint";
import { Header } from "header.slint";
import { Button, Icons, Segmented, Select, FocusRing, KeyFocus, ProBadge } from "parts.slint";
import { TypeChoice } from "first-run.slint";
import { ProUi, ProSheet, ProIcons } from "pro.slint";


export global PrefsUi {
    in property <int> language; // 0 system, 1 English, 2 Arabic
    in property <string> system-language; // "English", shown as "System (English)"
    in property <int> open-with; // 0 mini view, 1 full view, 2 extract right away
    in property <[string]> encodings; // "Auto-detect" first
    in property <int> encoding; // index into encodings
    in property <bool> grid-for-media;
    in property <int> theme; // 0 system, 1 light, 2 dark, 3 glass (Pro)
    in property <int> glass-frost; // 0 clear glass (40% tint) … 100 fully frosted
    in property <bool> glass-materials; // Windows: the Material row
    in property <int> glass-material; // 0 Acrylic, 1 Mica
    in property <int> app-icon; // Tokens.app-icons; 0 without a key
    in property <bool> default-grid;
    in property <bool> ratio-column;
    in property <int> new-format; // 0 ZIP, 1 TAR.ZST, 2 7Z, 3 TAR.GZ, 4 TAR.XZ
    in property <int> new-level; // 0 fastest, 1 balanced, 2 smallest
    in property <bool> always-exclude;
    in property <bool> smart-folder;
    in property <[TypeChoice]> types; // on: Crate opens it by default
    in property <int> defaults; // as FirstRunUi.defaults
    in property <string> defaults-error;
    callback make-default(/* type */ int);
    // A setting changed: `key` is its name after "pref." in state.ini.
    callback choose(/* key */ string, /* value */ int);
    callback close;
}

// input.sw: 36 × 20 track, 16 px knob.
component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: on ? Tokens.accent : Tokens.line.mix(Tokens.ink-3, 0.55);
    accessible-role: switch;
    accessible-label: label;
    accessible-checked: on;
    accessible-action-default => { root.toggled(); }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    kf49 := KeyFocus { activate => { root.toggled(); } }
    FocusRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; on: kf49.has-focus; radius: 10px; }
    Rectangle {
        x: Locale.rtl ? parent.width - self.width - (root.on ? 18px : 2px) : root.on ? 18px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: black.with-alpha(0.2);
        animate x { duration: 120ms; }
    }
}

// The Glass slider: clear glass to fully frosted. The window shows each
// step while dragging; the value is saved on release.
component FrostSlider inherits Rectangle {
    in property <float> value; // 0 … 1
    in property <string> label;
    callback chosen(float);
    property <float> drag: -1;
    property <float> shown: drag >= 0 ? drag : value;
    property <length> knob: 20px;
    // Arabic: frosted is on the left.
    property <length> knob-x: (Locale.rtl ? 1 - shown : shown) * (self.width - knob);
    width: 200px;
    height: 24px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: Math.round(shown * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 5;
    accessible-action-increment => { root.chosen(Math.min(1, value + 0.05)); }
    accessible-action-decrement => { root.chosen(Math.max(0, value - 0.05)); }
    function at(x: length) -> float {
        let v = Math.clamp((x - knob / 2) / (self.width - knob), 0, 1);
        Locale.rtl ? 1 - v : v
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Tokens.line.mix(Tokens.ink-3, 0.55);
    }
    Rectangle {
        x: Locale.rtl ? knob-x + knob / 2 : 0;
        y: (parent.height - self.height) / 2;
        width: Locale.rtl ? parent.width - knob-x - knob / 2 : knob-x + knob / 2;
        height: 4px;
        border-radius: 2px;
        background: Tokens.accent;
    }
    Rectangle {
        x: knob-x;
        y: (parent.height - self.height) / 2;
        width: knob;
        height: knob;
        border-radius: knob / 2;
        background: white;
        border-width: 1px;
        border-color: Tokens.line;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: black.with-alpha(0.2);
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                drag = at(self.mouse-x);
                Tokens.frost = drag;
            } else if e.kind == PointerEventKind.up && drag >= 0 {
                let v = drag;
                drag = -1;
                root.chosen(v);
            }
        }
        moved => {
            if self.pressed {
                drag = at(self.mouse-x);
                Tokens.frost = drag;
            }
        }
    }
    kf-frost := KeyFocus {
        arrows: true;
        // KeyFocus already turns Left / Right around for Arabic.
        step(d) => { root.chosen(Math.clamp(value + d * 0.05, 0, 1)); }
    }
    FocusRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; on: kf-frost.has-focus; radius: 12px; }
}

// .fmtchip: a file type; tinted when Crate opens it. A click on a plain
// one makes Crate its default app.
component TypeChip inherits Rectangle {
    in property <TypeChoice> item;
    in property <bool> enabled;
    callback clicked;
    height: 26px;
    border-radius: 6px;
    background: item.on ? Tokens.accent-soft : area.has-hover && enabled ? Tokens.line : Tokens.line.mix(Tokens.surface-2, 0.6);
    accessible-role: button;
    accessible-label: item.label;
    accessible-checked: item.on;
    accessible-action-default => { root.clicked(); }
    area := TouchArea {
        enabled: root.enabled && !root.item.on;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    kf80 := KeyFocus { enabled: root.enabled && !root.item.on; activate => { root.clicked(); } }
    FocusRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; on: kf80.has-focus; radius: 6px; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text { horizontal-alignment: Locale.start; text: root.item.label; color: root.item.on ? Tokens.accent-soft-ink : Tokens.ink-2; font-size: 11px; font-weight: 600; vertical-alignment: center; }
    }
}

// .it: title and description on the left, the control on the right.
component Item inherits Rectangle {
    in property <string> title;
    in property <string> note;
    in property <bool> first;
    if !root.first: Rectangle { y: 0; height: 1px; background: Tokens.line; }
    GridLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 14px;
        VerticalLayout { col: Locale.rtl ? 1 : 0; row: 0;
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { horizontal-alignment: Locale.start; text: root.title; color: Tokens.ink; font-size: 13px; font-weight: 600; wrap: word-wrap; }
            if root.note != "": Text { horizontal-alignment: Locale.start; text: root.note; color: Tokens.ink-2; font-size: 12px; wrap: word-wrap; }
        }
        VerticalLayout { col: Locale.rtl ? 0 : 1; row: 0;
            alignment: center;
            @children
        }
    }
}

// One icon of the App icon picker (Pro.dc.html): a ring when it's chosen,
// faded while it's locked.
component IconChoice inherits Rectangle {
    in property <image> source;
    in property <string> label;
    in property <bool> on;
    in property <bool> locked;
    callback clicked;
    callback step(int);
    width: 42px;
    height: 42px;
    border-radius: 12px;
    border-width: root.on ? 2px : 0;
    border-color: Tokens.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    Image {
        x: 5px;
        y: 5px;
        width: 32px;
        height: 32px;
        source: root.source;
        opacity: root.locked ? (area.has-hover ? 0.8 : 0.55) : 1;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := KeyFocus { arrows: true; activate => { root.clicked(); } step(d) => { root.step(d); } }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; on: focus.has-focus; radius: 12px; }
}

// .grp with its heading (.gh).
component Group inherits VerticalLayout {
    in property <string> title;
    spacing: 10px;
    alignment: start;
    Text { horizontal-alignment: Locale.start; text: root.title; color: Tokens.ink; font-size: 15px; font-weight: 600; }
    Rectangle {
        border-radius: 14px;
        border-width: 1px;
        border-color: Tokens.line;
        background: Tokens.card;
        VerticalLayout {
            @children
        }
    }
}

export component PrefsWindow inherits Window {
    in property <bool> custom-frame;
    in property <length> titlebar-inset;
    in property <length> titlebar-height;
    callback start-drag;
    callback minimize;
    callback toggle-maximize;

    title: @tr("Preferences");
    icon: Tokens.app-image;
    preferred-width: 760px;
    preferred-height: 760px;
    min-width: 560px;
    min-height: 480px;
    no-frame: custom-frame || Frame.caption;
    background: Tokens.glass || Frame.custom ? transparent : Tokens.surface-2;
    default-font-family: Locale.font;
    default-font-size: 14px;
    default-font-weight: 500;
    forward-focus: keys;

    // Glass, or Crate's own frame: the window is cleared to transparent and
    // its body drawn here. A translucent Window.background is the GL clear
    // color, which isn't premultiplied, and the compositor then shows it as
    // solid white.
    if Tokens.glass || Frame.custom: WindowFrame { fill: Tokens.glass ? Tokens.window : Tokens.surface-2; }

    if Frame.caption: CaptionBar {
        y: 0;
        width: root.width;
        title: root.title;
        start-drag => { root.start-drag(); }
        minimize => { root.minimize(); }
        toggle-maximize => { root.toggle-maximize(); }
        close => { PrefsUi.close(); }
    }

    keys := FocusScope {
        x: Frame.inset;
        y: Frame.inset + Frame.caption-height;
        width: root.width - 2 * Frame.inset;
        height: root.height - 2 * Frame.inset - Frame.caption-height;
        key-pressed(event) => {
            if ProUi.show {
                if event.text == Key.Escape && !ProUi.busy { ProUi.cancel(); return accept; }
                return reject;
            }
            if event.text == Key.Escape || ((event.text == "w" || event.text == "W") && event.modifiers.control) {
                PrefsUi.close();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Where the system's title bar says "Preferences" (Windows), or
            // Crate's caption strip does, a second title would only repeat it.
            if root.custom-frame || root.titlebar-inset > 0: Header {
                title: @tr("Preferences");
                custom-frame: root.custom-frame;
                titlebar-inset: root.titlebar-inset;
                titlebar-height: root.titlebar-height;
                start-drag => { root.start-drag(); }
                minimize => { root.minimize(); }
                toggle-maximize => { root.toggle-maximize(); }
                close => { PrefsUi.close(); }
            }
            ScrollView {
                vertical-stretch: 1;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        max-width: 860px;
                        horizontal-stretch: 1;
                        alignment: start;
                        padding-left: 32px;
                        padding-right: 32px;
                        padding-top: 24px;
                        padding-bottom: 32px;
                        spacing: 22px;

                        Group {
                            title: @tr("Crate Pro");
                            if !ProUi.active: Item {
                                first: true;
                                title: @tr("Not activated");
                                note: @tr("Glass theme and seven more app icons, {} once", ProUi.price);
                                GridLayout {
                                    spacing: 8px;
                                    Button { col: Locale.rtl ? 1 : 0; row: 0; text: @tr("Enter key"); min-height: 34px; clicked => { ProUi.open(1); } }
                                    Button { col: Locale.rtl ? 0 : 1; row: 0; text: @tr("Upgrade…"); primary: true; min-height: 34px; clicked => { ProUi.open(0); } }
                                }
                            }
                            if ProUi.active: GridLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                spacing: 14px;
                                VerticalLayout { col: Locale.rtl ? 2 : 0; row: 0;
                                    alignment: center;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 8px;
                                        background: Tokens.success.mix(Tokens.bg, 0.12);
                                        Icon { size: 16; stroke: Tokens.success; commands: ProIcons.check; }
                                    }
                                }
                                VerticalLayout { col: 1; row: 0;
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { horizontal-alignment: Locale.start; text: @tr("Active"); color: Tokens.ink; font-size: 13px; font-weight: 600; }
                                    Text { horizontal-alignment: Locale.start; text: ProUi.since; color: Tokens.ink-2; font-size: 12px; wrap: word-wrap; }
                                }
                                VerticalLayout { col: Locale.rtl ? 0 : 2; row: 0;
                                    alignment: center;
                                    Button { text: @tr("Remove license"); quiet: true; min-height: 34px; clicked => { ProUi.remove(); } }
                                }
                            }
                        }

                        Group {
                            title: @tr("Opening archives");
                            Item {
                                first: true;
                                title: @tr("When I double-click an archive");
                                note: @tr("The mini view is one click from extracting everything");
                                Segmented {
                                    options: [@tr("Mini view"), @tr("Full view"), @tr("Extract right away")];
                                    current: PrefsUi.open-with;
                                    chosen(i) => { PrefsUi.choose("open_with", i); }
                                }
                            }
                            Item {
                                title: @tr("Filename encoding for old ZIPs");
                                note: @tr("Used when names aren’t stored as UTF-8");
                                Select {
                                    label: @tr("Filename encoding");
                                    options: PrefsUi.encodings;
                                    current: PrefsUi.encoding;
                                    chosen(i) => { PrefsUi.choose("encoding", i); }
                                }
                            }
                            Item {
                                title: @tr("Grid view for media folders");
                                note: @tr("Switch to thumbnails when most items are photos or videos");
                                Switch {
                                    label: @tr("Grid view for media folders");
                                    on: PrefsUi.grid-for-media;
                                    toggled => { PrefsUi.choose("grid_for_media", PrefsUi.grid-for-media ? 0 : 1); }
                                }
                            }
                        }

                        Group {
                            title: @tr("Appearance");
                            Item {
                                first: true;
                                title: @tr("Language");
                                note: @tr("Arabic switches the layout to right-to-left");
                                Select {
                                    label: @tr("Language");
                                    options: [@tr("System ({})", PrefsUi.system-language), "English", "العربية"];
                                    current: PrefsUi.language;
                                    chosen(i) => { PrefsUi.choose("language", i); }
                                }
                            }
                            Item {
                                title: @tr("Theme");
                                note: @tr("Follows your desktop by default");
                                Segmented {
                                    options: [@tr("System"), @tr("Light"), @tr("Dark"), @tr("Glass")];
                                    current: PrefsUi.theme;
                                    // Glass is Pro: without a key it opens the upgrade sheet.
                                    badge-index: ProUi.active ? -1 : 3;
                                    badge: "PRO";
                                    chosen(i) => {
                                        if i == 3 && !ProUi.active { ProUi.open(0); } else { PrefsUi.choose("theme", i); }
                                    }
                                }
                            }
                            if PrefsUi.theme == 3: Item {
                                title: @tr("Glass");
                                note: @tr("From clear glass to fully frosted. More frost makes text easier to read over other windows.");
                                GridLayout {
                                    spacing: 10px;
                                    Text { col: Locale.rtl ? 2 : 0; row: 0; text: @tr("Clear"); color: Tokens.ink-2; font-size: 12px; vertical-alignment: center; }
                                    FrostSlider {
                                        col: 1; row: 0;
                                        label: @tr("Glass");
                                        value: PrefsUi.glass-frost / 100;
                                        chosen(v) => { PrefsUi.choose("glass_frost", Math.round(v * 100)); }
                                    }
                                    Text { col: Locale.rtl ? 0 : 2; row: 0; text: @tr("Frosted"); color: Tokens.ink-2; font-size: 12px; vertical-alignment: center; }
                                }
                            }
                            if PrefsUi.theme == 3 && PrefsUi.glass-materials: Item {
                                title: @tr("Material");
                                note: @tr("Acrylic blurs what’s behind the window. Mica takes its tint from the wallpaper and needs Windows 11.");
                                Segmented {
                                    options: [@tr("Acrylic"), @tr("Mica")];
                                    current: PrefsUi.glass-material;
                                    chosen(i) => { PrefsUi.choose("glass_material", i); }
                                }
                            }
                            // App icon (Pro): the icons go under the title, the
                            // row is too narrow for eight beside it.
                            Rectangle {
                                Rectangle { y: 0; height: 1px; background: Tokens.line; }
                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: 14px;
                                    padding-bottom: 14px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        spacing: 2px;
                                        GridLayout {
                                            spacing: 6px;
                                            Text { col: Locale.rtl ? 2 : 0; row: 0; text: @tr("App icon"); color: Tokens.ink; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                            if !ProUi.active: ProBadge { col: 1; row: 0; }
                                            Rectangle { col: Locale.rtl ? 0 : 2; row: 0; horizontal-stretch: 1; }
                                        }
                                        Text { horizontal-alignment: Locale.start; text: @tr("Shown in the taskbar and on Crate’s windows"); color: Tokens.ink-2; font-size: 12px; wrap: word-wrap; }
                                    }
                                    GridLayout {
                                        spacing: 6px;
                                        for img[i] in Tokens.app-icons: IconChoice {
                                            col: Locale.rtl ? Tokens.app-icons.length - i : i; row: 0;
                                            source: img;
                                            label: [@tr("Layers"), @tr("Open Lid"), @tr("Ark"), @tr("Zip"), @tr("Squeeze"), @tr("A monogram"), @tr("Open crate"), @tr("Vault")][i];
                                            on: i == PrefsUi.app-icon;
                                            locked: i != 0 && !ProUi.active;
                                            // Layers is free; the others open the upgrade sheet without a key.
                                            clicked => {
                                                if i != 0 && !ProUi.active { ProUi.open(0); } else { PrefsUi.choose("app_icon", i); }
                                            }
                                            step(d) => {
                                                if ProUi.active { PrefsUi.choose("app_icon", Math.clamp(PrefsUi.app-icon + d, 0, Tokens.app-icons.length - 1)); }
                                            }
                                        }
                                        Rectangle { col: Locale.rtl ? 0 : Tokens.app-icons.length; row: 0; horizontal-stretch: 1; }
                                    }
                                }
                            }
                            Item {
                                title: @tr("Default view");
                                note: @tr("How archive contents are shown");
                                Segmented {
                                    options: [@tr("List"), @tr("Grid")];
                                    current: PrefsUi.default-grid ? 1 : 0;
                                    chosen(i) => { PrefsUi.choose("default_grid", i); }
                                }
                            }
                            Item {
                                title: @tr("Show compression ratio column");
                                Switch {
                                    label: @tr("Show compression ratio column");
                                    on: PrefsUi.ratio-column;
                                    toggled => { PrefsUi.choose("ratio_column", PrefsUi.ratio-column ? 0 : 1); }
                                }
                            }
                        }

                        Group {
                            title: @tr("New archives");
                            Item {
                                first: true;
                                title: @tr("Default format");
                                note: @tr("Used by the New archive dialog");
                                Select {
                                    label: @tr("Default format");
                                    options: [@tr("ZIP"), @tr("TAR.ZST"), "7Z", @tr("TAR.GZ"), @tr("TAR.XZ")];
                                    current: PrefsUi.new-format;
                                    chosen(i) => { PrefsUi.choose("new_format", i); }
                                }
                            }
                            Item {
                                title: @tr("Default level");
                                note: @tr("Balanced is a good trade-off for most files");
                                Select {
                                    label: @tr("Default compression level");
                                    options: [@tr("Fastest"), @tr("Balanced"), @tr("Smallest")];
                                    current: PrefsUi.new-level;
                                    chosen(i) => { PrefsUi.choose("new_level", i); }
                                }
                            }
                            Item {
                                title: @tr("Always exclude");
                                note: @tr(".git, node_modules, .DS_Store, Thumbs.db");
                                Switch {
                                    label: @tr("Always exclude");
                                    on: PrefsUi.always-exclude;
                                    toggled => { PrefsUi.choose("always_exclude", PrefsUi.always-exclude ? 0 : 1); }
                                }
                            }
                        }

                        Group {
                            title: @tr("Extraction & integration");
                            Item {
                                first: true;
                                title: @tr("Smart folder");
                                note: @tr("Only create a folder when the archive has more than one top-level item");
                                Switch {
                                    label: @tr("Smart folder");
                                    on: PrefsUi.smart-folder;
                                    toggled => { PrefsUi.choose("smart_folder", PrefsUi.smart-folder ? 0 : 1); }
                                }
                            }
                            Item {
                                title: @tr("Open these with Crate");
                                note: PrefsUi.defaults-error != "" ? PrefsUi.defaults-error
                                    : PrefsUi.defaults == 0 ? @tr("Click a type to make Crate its default app. To use another app, pick it in Files → Open With.")
                                    : PrefsUi.defaults == 1 ? @tr("Flatpak: in Files, right-click an archive → Properties → Open With → Crate → Set as default.")
                                    : PrefsUi.defaults == 2 ? @tr("Crate isn’t installed as an app yet, so it can’t be the default.")
                                    : PrefsUi.defaults == 4 ? @tr("Click a type to open Settings → Default apps, where you choose Crate for it.")
                                    : PrefsUi.defaults == 5 ? @tr("Click a type to make Crate its default app. To use another app, pick it in Finder → Get Info → Open with.")
                                    : @tr("Not supported on this system yet.");
                                GridLayout {
                                    spacing: 6px;
                                    for t[i] in PrefsUi.types: TypeChip { col: Locale.rtl ? (PrefsUi.types).length - 1 - i : i; row: 0;
                                        item: t;
                                        enabled: PrefsUi.defaults == 0 || PrefsUi.defaults == 4 || PrefsUi.defaults == 5;
                                        clicked => { PrefsUi.make-default(i); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if ProUi.show: ProSheet { }
    }
}
