// Color tokens from design/DESIGN.md (light / dark, and glass light / dark).
// Add new colors there first; don't use raw hex values anywhere else in the UI.
import { Palette } from "std-widgets.slint";

export global Tokens {
    // The Glass theme (Pro; prefs.rs): panes of glass over the OS material.
    // It follows the system's light or dark like the System theme.
    in property <bool> glass;
    // How frosted the glass is (Preferences → Appearance → Glass): 0 is clear
    // glass, a 40% tint; 1 is fully frosted, solid. Linux starts higher: GNOME
    // doesn't blur what's behind a window (DESIGN.md, "Per-platform variants").
    in-out property <float> frost;
    // Windows: Mica behind the window. Its backdrop hides what's behind the
    // window, so panes are firmer than on Acrylic (GlassMiniWin.dc.html).
    in property <bool> mica;
    // Windows Mica: it comes with its own tint, so the window adds none at
    // frost 0 and panes are lighter. Acrylic takes Crate's tint, as on macOS.
    in property <bool> material;
    // The app icon (Pro; Preferences → Appearance): 0 is Layers, the
    // others are the alternates in `assets/icons/alt/`, in the picker's order.
    in property <int> app-icon;
    out property <[image]> app-icons: [
        @image-url("../../assets/icons/png/crate-256.png"),
        @image-url("../../assets/icons/alt/png/open-lid-256.png"),
        @image-url("../../assets/icons/alt/png/ark-256.png"),
        @image-url("../../assets/icons/alt/png/zip-256.png"),
        @image-url("../../assets/icons/alt/png/squeeze-256.png"),
        @image-url("../../assets/icons/alt/png/monogram-256.png"),
        @image-url("../../assets/icons/alt/png/open-crate-256.png"),
        @image-url("../../assets/icons/alt/png/vault-256.png"),
    ];
    out property <image> app-image: app-icons[app-icon];
    // Follows the system color scheme, or the Theme preference (prefs.rs).
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Glass: panes.
    out property <color> bg: glass ? (dark ? #1c2029.with-alpha(material ? 0.35 + 0.65 * frost : 0.65 + 0.35 * frost) : #ffffff.with-alpha(mica ? 0.75 + 0.25 * frost : material ? 0.3 + 0.7 * frost : 0.55 + 0.45 * frost)) : dark ? #0f1115 : #ffffff;
    out property <color> surface-2: glass ? (dark ? #ffffff14 : #ffffff.with-alpha(material ? 0.25 + 0.6 * frost : 0.45 + 0.4 * frost)) : dark ? #12151b : #f7f8fa; // sidebar, details
    out property <color> chrome: glass ? transparent : dark ? #14171d : #fbfbfc; // header, footer
    out property <color> line: glass ? (dark ? #ffffff26 : #ffffffb3) : dark ? #232832 : #e6e8ec;
    out property <color> ink: glass && dark ? #f1f4f9 : dark ? #e7eaf0 : #0f172a;
    // On glass, secondary text stays strong: the wallpaper shows through.
    out property <color> ink-2: glass ? (dark ? #cfd5df : #1d2939) : dark ? #a9b0bd : #475467;
    out property <color> ink-3: glass ? (dark ? #b4bcc8 : #334155) : dark ? #8a93a3 : #667085;
    out property <color> accent: glass ? (dark ? #4a65f0e6 : #3352e0e6) : dark ? #4a65f0 : #3352e0; // button background
    out property <color> accent-soft: glass ? (dark ? #4a65f038 : #3352e029) : dark ? #1e2747 : #eef1fd;
    out property <color> accent-soft-ink: glass ? (dark ? #c9d4ff : #1e3399) : dark ? #afc0ff : #2a44c2; // text on accent-soft
    out property <color> selection: glass ? (dark ? #4a65f047 : #3352e02e) : dark ? #1a2240 : #eef1fd;
    out property <color> success: dark ? #3dd68c : #0e7a4f;
    out property <color> warning: dark ? #f5a524 : #b45309;
    out property <color> danger: dark ? #ff8a80 : #c2261b;
    out property <color> crypto: dark ? #cdb4fa : #6b3fc4;
    // Glass: the window itself, under the panes; and dialogs over it, which
    // stay solid so nothing shows through their text. Light glass dialogs
    // are a soft grey-blue, so the white glass controls in them still show.
    out property <color> window: glass ? (dark ? #0f1115.with-alpha(material ? frost : 0.45 + 0.55 * frost) : #ffffff.with-alpha(material ? frost : 0.4 + 0.6 * frost)) : bg;
    out property <color> sheet: glass ? (dark ? #161a21 : #eef1f6) : dark ? chrome : bg;
    // A group or card on a page (Preferences): solid normally, a pane on glass.
    out property <color> card: glass ? bg : dark ? chrome : bg;
    // Glass buttons: a glass fill with a white rim (GlassMini.dc.html, .gbtn).
    out property <color> glass-fill: dark ? #ffffff1a : #ffffff99;
    out property <color> glass-fill-hover: dark ? #ffffff2e : #ffffffd9;
    out property <color> glass-rim: dark ? #ffffff40 : #ffffffe6;
    // Windows caption buttons (GlassMiniWin.dc.html, .cap): hover, and Close on hover.
    out property <color> caption-hover: dark ? #ffffff14 : #0000000f;
    out property <color> caption-close: #c42b1c;
    // The PRO label (Pro.dc.html).
    out property <color> pro: #1e2f8f;
}
