// Color tokens from design/DESIGN.md (light / dark, and glass light / dark).
// Add new colors there first; don't use raw hex values anywhere else in the UI.
import { Palette } from "std-widgets.slint";

export global Tokens {
    // The Glass theme (Pro; prefs.rs): panes of glass over the OS material.
    // It follows the system's light or dark like the System theme.
    in property <bool> glass;
    // Follows the system color scheme, or the Theme preference (prefs.rs).
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Glass: panes.
    out property <color> bg: glass ? (dark ? #1c2029a6 : #ffffff8c) : dark ? #0f1115 : #ffffff;
    out property <color> surface-2: glass ? (dark ? #ffffff14 : #ffffff73) : dark ? #12151b : #f7f8fa; // sidebar, details
    out property <color> chrome: glass ? transparent : dark ? #14171d : #fbfbfc; // header, footer
    out property <color> line: glass ? (dark ? #ffffff26 : #ffffffb3) : dark ? #232832 : #e6e8ec;
    out property <color> ink: glass && dark ? #f1f4f9 : dark ? #e7eaf0 : #0f172a;
    // On glass, secondary text stays strong: the wallpaper shows through.
    out property <color> ink-2: glass ? (dark ? #cfd5df : #1d2939) : dark ? #a9b0bd : #475467;
    out property <color> ink-3: glass ? (dark ? #b4bcc8 : #334155) : dark ? #8a93a3 : #667085;
    out property <color> accent: glass ? (dark ? #4a65f0e6 : #3352e0e6) : dark ? #4a65f0 : #3352e0; // button background
    out property <color> accent-soft: glass ? (dark ? #4a65f038 : #3352e029) : dark ? #1e2747 : #eef1fd;
    out property <color> accent-soft-ink: glass ? (dark ? #c9d4ff : #1e3399) : dark ? #afc0ff : #2a44c2; // text on accent-soft
    out property <color> selection: glass ? (dark ? #4a65f047 : #3352e02e) : dark ? #1a2240 : #eef1fd;
    out property <color> success: dark ? #3dd68c : #0e7a4f;
    out property <color> warning: dark ? #f5a524 : #b45309;
    out property <color> danger: dark ? #ff8a80 : #c2261b;
    out property <color> crypto: dark ? #cdb4fa : #6b3fc4;
    // Glass: the window itself, under the panes; and dialogs over it, which
    // stay solid so nothing shows through their text.
    out property <color> window: glass ? (dark ? #0f111573 : #ffffff66) : bg;
    out property <color> sheet: glass ? (dark ? #161a21 : #ffffff) : dark ? chrome : bg;
    // A group or card on a page (Preferences): solid normally, a pane on glass.
    out property <color> card: glass ? bg : dark ? chrome : bg;
    // The PRO label (Pro.dc.html).
    out property <color> pro: #1e2f8f;
}
