// Crate's own window frame, where Crate draws its header (`custom-frame`,
// Linux): the window keeps a clear margin around its body, where a shadow
// falls and the pointer resizes the window; the body has rounded corners
// and a 1 px rim. Maximized or full screen, the body fills the window.
// Sizes per platform: design/DESIGN.md → Glass theme → Per-platform variants.
import { Tokens } from "tokens.slint";
import { Locale } from "locale.slint";

export global Frame {
    // Set from Rust per window (`connect_frame` in lib.rs).
    in property <bool> custom;
    in property <bool> maximized;
    out property <bool> drawn: custom && !maximized;
    // The clear margin, for the shadow and the resize grip.
    out property <length> inset: drawn ? 12px : 0;
    // Corner radius of the body: Ubuntu's 12 px, 16 px on glass.
    out property <length> radius: drawn ? (Tokens.glass ? 16px : 12px) : 0;
    // Windows on glass: no system title bar; Crate draws a 32 px caption
    // strip with 46 × 32 buttons instead (`CaptionBar`).
    in property <bool> caption;
    out property <length> caption-height: caption ? 32px : 0;
    // The pointer is on the maximize button. Windows reports it to Rust, as
    // it hit-tests that button itself to offer Snap Layouts.
    in property <bool> max-hover;
    // The window's size changed: Rust checks whether it's maximized.
    callback resized;
    // Resizing from an edge: 0 north, then clockwise to 7 north-west.
    callback start-resize(int);
}

// One resize grip in the margin.
component Grip inherits TouchArea {
    in property <int> edge;
    pointer-event(event) => {
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
            Frame.start-resize(self.edge);
        }
    }
}

// The body under a window's content: its fill, the shadow and the rim. The
// window puts its content `Frame.inset` in from each side.
export component WindowFrame inherits Rectangle {
    in property <color> fill;

    changed width => { Frame.resized(); }
    changed height => { Frame.resized(); }

    // The shadow: rings fading out from the body, not one blurred shape,
    // so it doesn't darken a see-through body from below.
    if Frame.drawn: Rectangle {
        for i in 10: Rectangle {
            x: Frame.inset - (i + 1) * 1px;
            y: Frame.inset - (i + 1) * 1px + 2px;
            width: root.width - 2 * Frame.inset + (i + 1) * 2px;
            height: root.height - 2 * Frame.inset + (i + 1) * 2px;
            border-radius: Frame.radius + (i + 1) * 1px;
            border-width: 1px;
            border-color: black.with-alpha(0.13 * (1 - i / 10) * (1 - i / 10));
        }
    }
    Rectangle {
        x: Frame.inset;
        y: Frame.inset;
        width: root.width - 2 * Frame.inset;
        height: root.height - 2 * Frame.inset;
        border-radius: Frame.radius;
        background: root.fill;
        border-width: Frame.drawn ? 1px : 0;
        border-color: Tokens.glass ? Tokens.glass-rim : Tokens.line;
    }

    // The grips: the sides, and 20 px squares at the corners.
    if Frame.drawn: Rectangle {
        property <length> m: Frame.inset;
        property <length> c: 20px;
        Grip { edge: 0; x: c; y: 0; width: root.width - 2 * c; height: m; mouse-cursor: MouseCursor.n-resize; }
        Grip { edge: 4; x: c; y: root.height - m; width: root.width - 2 * c; height: m; mouse-cursor: MouseCursor.s-resize; }
        Grip { edge: 6; x: 0; y: c; width: m; height: root.height - 2 * c; mouse-cursor: MouseCursor.w-resize; }
        Grip { edge: 2; x: root.width - m; y: c; width: m; height: root.height - 2 * c; mouse-cursor: MouseCursor.e-resize; }
        Grip { edge: 7; x: 0; y: 0; width: c; height: c; mouse-cursor: MouseCursor.nw-resize; }
        Grip { edge: 1; x: root.width - c; y: 0; width: c; height: c; mouse-cursor: MouseCursor.ne-resize; }
        Grip { edge: 5; x: 0; y: root.height - c; width: c; height: c; mouse-cursor: MouseCursor.sw-resize; }
        Grip { edge: 3; x: root.width - c; y: root.height - c; width: c; height: c; mouse-cursor: MouseCursor.se-resize; }
    }
}

// One caption button: 46 × 32, a flat hover; Close turns red.
component CaptionButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <float> icon-size: 14;
    in property <bool> close;
    in property <bool> hover-from-system;
    callback clicked;
    property <bool> hover: area.has-hover || root.hover-from-system;
    width: 46px;
    height: 32px;
    background: root.hover ? (root.close ? Tokens.caption-close : Tokens.caption-hover) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Path {
        width: root.icon-size * 1px;
        height: root.icon-size * 1px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke-width: 1.2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        stroke: root.hover && root.close ? white : Tokens.ink;
        commands: root.icon;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

// Windows on glass: the strip in place of the system title bar, with the
// app icon, the title and the caption buttons at the far end
// (GlassMiniWin.dc.html). It's the window's drag region. Rust hit-tests
// the maximize button for Snap Layouts at the same place: 46–92 px from
// the end, 32 px tall.
export component CaptionBar inherits Rectangle {
    in property <string> title;
    callback start-drag;
    callback minimize;
    callback toggle-maximize;
    callback close;
    height: Frame.caption-height;
    drag := TouchArea {
        property <length> press-x;
        property <length> press-y;
        property <bool> pressing;
        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    self.pressing = true;
                    self.press-x = self.mouse-x;
                    self.press-y = self.mouse-y;
                } else if event.kind == PointerEventKind.up {
                    self.pressing = false;
                }
            }
        }
        moved => {
            if self.pressing && (abs(self.mouse-x - self.press-x) > 4px || abs(self.mouse-y - self.press-y) > 4px) {
                self.pressing = false;
                root.start-drag();
            }
        }
        double-clicked => { root.toggle-maximize(); }
    }
    GridLayout {
        padding-left: Locale.rtl ? 0 : 12px;
        padding-right: Locale.rtl ? 12px : 0;
        spacing: 8px;
        VerticalLayout {
            col: Locale.rtl ? 2 : 0; row: 0;
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: @image-url("../../assets/icons/png/crate-256.png");
            }
        }
        Text {
            col: 1; row: 0;
            text: root.title;
            color: Tokens.ink;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: Locale.rtl ? right : left;
            horizontal-stretch: 1;
            overflow: elide;
        }
        GridLayout {
            col: Locale.rtl ? 0 : 2; row: 0;
            spacing: 0;
            CaptionButton {
                col: Locale.rtl ? 2 : 0; row: 0;
                label: @tr("Minimize");
                icon: "M5 12h14";
                clicked => { root.minimize(); }
            }
            CaptionButton {
                col: 1; row: 0;
                label: @tr("Maximize");
                icon: "M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z";
                icon-size: 12;
                hover-from-system: Frame.max-hover;
                clicked => { root.toggle-maximize(); }
            }
            CaptionButton {
                col: Locale.rtl ? 0 : 2; row: 0;
                label: @tr("Close");
                icon: "M5 5l14 14M19 5 5 19";
                close: true;
                clicked => { root.close(); }
            }
        }
    }
}
